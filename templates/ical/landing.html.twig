{% extends 'base.html.twig' %}
{% block title %}Fusionar Calendarios iCal Gratis | Sincroniza Booking, Airbnb y Vrbo{% endblock %}

{% block meta %}
    <meta name="description" content="Herramienta gratuita para sincronizar y fusionar calendarios iCal de Booking, Airbnb, Vrbo e iTraveo en un único enlace. Evita dobles reservas en tu alquiler vacacional.">
    <meta name="keywords" content="fusionar ical, sincronizar booking airbnb, sincronizador calendarios alquiler vacacional, evitar dobles reservas, ical merger gratis">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ url('ical_landing') }}" />

    <!-- Open Graph (Para tarjetas al compartir en redes y WhatsApp) -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="Fusionador de Calendarios iCal | Sincronización Vacacional">
    <meta property="og:description" content="Consolida la disponibilidad de Booking, Airbnb e iTraveo en una sola URL pública y evita overselling.">
    <meta property="og:url" content="{{ url('ical_landing') }}">

    <!-- Schema.org (Datos estructurados de Google para Rich Snippets / SoftwareApplication) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "iCal Merger & Synchronizer",
      "operatingSystem": "All",
      "applicationCategory": "BusinessApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      },
      "description": "Herramienta web para combinar múltiples feeds iCal/ICS en una única URL unificada para gestores de alquiler vacacional."
    }
    </script>
{% endblock %}

{% block body %}
<link rel="stylesheet" href="{{ asset('css/tailwind.css') }}">

<div class="min-h-screen bg-slate-900 text-slate-100 flex flex-col items-center justify-start p-4 py-12 space-y-12">

    <!-- BLOQUE 1: Resultado de la URL generada (Solo se muestra cuando se ha enviado el formulario) -->
    {% if mergedUrl is defined and mergedUrl is not empty %}
    <div class="max-w-2xl w-full bg-slate-800 border border-emerald-500/30 rounded-xl shadow-2xl p-6 sm:p-8 text-center space-y-5 animate-fade-in">
        <div class="mx-auto w-12 h-12 bg-emerald-500/10 text-emerald-400 rounded-full flex items-center justify-center text-2xl border border-emerald-500/20">
            ✓
        </div>

        <div>
            <h2 class="text-2xl font-bold text-white mb-1">¡Tu calendario unificado está listo!</h2>
            <p class="text-slate-400 text-sm">
                Copia este enlace e impórtalo en Booking, Airbnb, Vrbo e iTraveo para sincronizar tu disponibilidad.
            </p>
        </div>

        <!-- Input con botón Copiar incorporado -->
        <div class="space-y-2 text-left">
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400">Enlace iCal Único</label>
            <div class="relative flex items-center">
                <input type="text" id="generatedUrl" readonly value="{{ mergedUrl }}"
                       class="w-full bg-slate-900 border border-slate-700 rounded-lg pl-4 pr-28 py-3 text-sm text-indigo-300 font-mono focus:outline-none select-all">

                <button type="button" id="copyBtn" onclick="copyToClipboard()"
                        class="absolute right-1.5 top-1.5 bottom-1.5 px-4 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold rounded-md transition flex items-center gap-1.5 shadow-md">
                    <svg id="copyIcon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 012-2v-8a2 2 0 01-2-2h-8a2 2 0 01-2 2v8a2 2 0 012 2z"></path>
                    </svg>
                    <span id="copyText">Copiar</span>
                </button>
            </div>
        </div>

        <!-- Mensaje de confirmación (oculto por defecto) -->
        <div id="toastFeedback" class="hidden bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs py-2 px-4 rounded-lg flex items-center justify-center gap-2 transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>¡Enlace copiado al portapapeles con éxito!</span>
        </div>
    </div>
    {% endif %}

    <!-- BLOQUE 2: Tarjeta Principal del Formulario -->
    <div class="max-w-2xl w-full bg-slate-800 border border-slate-700 rounded-xl shadow-2xl p-6 sm:p-8">

        <!-- Header -->
        <div class="mb-8 text-center">
            <span class="inline-block bg-indigo-500/10 text-indigo-400 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider mb-2 border border-indigo-500/20">
                Hub de Reservas
            </span>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-white mb-2">Fusionador de Calendarios iCal</h1>
            <p class="text-slate-400 text-sm sm:text-base">
                Consolida la disponibilidad de Booking, Airbnb, Vrbo e iTraveo en una sola URL pública y evita dobles reservas en tu alquiler vacacional.
            </p>
        </div>

        {% for message in app.flashes('error') %}
            <div class="mb-6 bg-red-500/10 border border-red-500/30 text-red-400 px-4 py-3 rounded-lg text-sm">
                {{ message }}
            </div>
        {% endfor %}

        <!-- Formulario -->
        <form action="{{ path('ical_create') }}" method="POST" id="icalForm" class="space-y-4">
            <div id="urlsContainer" class="space-y-3">
                <label class="block text-sm font-medium text-slate-300">Fuentes de iCal</label>

                <!-- Input inicial 1 -->
                <div class="url-input-group flex gap-2">
                    <input type="url" name="urls[]" required placeholder="https://... (ej. Booking iCal)"
                           class="flex-1 bg-slate-900 border border-slate-700 rounded-lg px-4 py-2.5 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500">
                    <button type="button" class="remove-btn hidden px-3 py-2 bg-slate-700/50 hover:bg-red-500/20 text-slate-400 hover:text-red-400 rounded-lg border border-slate-600 transition">
                        ✕
                    </button>
                </div>

                <!-- Input inicial 2 -->
                <div class="url-input-group flex gap-2">
                    <input type="url" name="urls[]" placeholder="https://... (ej. Airbnb iCal)"
                           class="flex-1 bg-slate-900 border border-slate-700 rounded-lg px-4 py-2.5 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500">
                    <button type="button" class="remove-btn px-3 py-2 bg-slate-700/50 hover:bg-red-500/20 text-slate-400 hover:text-red-400 rounded-lg border border-slate-600 transition" onclick="removeInput(this)">
                        ✕
                    </button>
                </div>
            </div>

            <!-- Botón para añadir más inputs -->
            <button type="button" id="addUrlBtn"
                    class="w-full py-2.5 border border-dashed border-slate-600 hover:border-indigo-500/50 text-slate-400 hover:text-indigo-400 rounded-lg text-sm font-medium transition flex items-center justify-center gap-2">
                <span>+</span> Añadir otra plataforma
            </button>

            <!-- Submit -->
            <div class="pt-4">
                <button type="submit"
                        class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-3 px-6 rounded-lg shadow-lg shadow-indigo-600/30 transition transform active:scale-[0.98]">
                    Generar URL Única Gratis
                </button>
            </div>
        </form>
    </div>

    <!-- SECCIÓN SEO: Cómo funciona y Preguntas Frecuentes -->
    <div class="max-w-4xl w-full space-y-12 text-slate-300 px-2">

        <!-- Bloque: Cómo funciona -->
        <section class="space-y-6">
            <h2 class="text-2xl font-bold text-white text-center">¿Cómo sincronizar tus calendarios en 3 pasos?</h2>
            <div class="grid md:grid-cols-3 gap-6">
                <div class="bg-slate-800/60 border border-slate-700/60 p-5 rounded-xl">
                    <div class="w-8 h-8 bg-indigo-600/20 text-indigo-400 rounded-lg flex items-center justify-center font-bold mb-3">1</div>
                    <h3 class="font-semibold text-white mb-1">Copia tus enlaces</h3>
                    <p class="text-sm text-slate-400">Exporta las URLs iCal (.ics) de tus anuncios en Booking, Airbnb, Vrbo o iTraveo.</p>
                </div>
                <div class="bg-slate-800/60 border border-slate-700/60 p-5 rounded-xl">
                    <div class="w-8 h-8 bg-indigo-600/20 text-indigo-400 rounded-lg flex items-center justify-center font-bold mb-3">2</div>
                    <h3 class="font-semibold text-white mb-1">Fusiónalos aquí</h3>
                    <p class="text-sm text-slate-400">Pega todas tus URLs en el formulario y genera un único enlace `.ics` unificado.</p>
                </div>
                <div class="bg-slate-800/60 border border-slate-700/60 p-5 rounded-xl">
                    <div class="w-8 h-8 bg-indigo-600/20 text-indigo-400 rounded-lg flex items-center justify-center font-bold mb-3">3</div>
                    <h3 class="font-semibold text-white mb-1">Sincronización total</h3>
                    <p class="text-sm text-slate-400">Importa tu nueva URL en todas tus OTAs para mantener la disponibilidad sincronizada.</p>
                </div>
            </div>
        </section>

        <!-- Bloque: Preguntas Frecuentes (FAQ) -->
        <section class="space-y-6 bg-slate-800/40 border border-slate-700/50 p-6 sm:p-8 rounded-xl">
            <h2 class="text-2xl font-bold text-white mb-4">Preguntas Frecuentes (FAQ)</h2>

            <div class="space-y-4 text-sm sm:text-base">
                <div>
                    <h3 class="font-semibold text-indigo-300">¿Qué es un archivo iCal / ICS?</h3>
                    <p class="text-slate-400 mt-1">
                        Un archivo o enlace iCal (extensión `.ics`) es un estándar internacional utilizado por la mayoría de las plataformas de alquiler vacacional para compartir calendarios de ocupación en tiempo real.
                    </p>
                </div>
                <hr class="border-slate-700/50">
                <div>
                    <h3 class="font-semibold text-indigo-300">¿Por qué necesito fusionar mis enlaces iCal?</h3>
                    <p class="text-slate-400 mt-1">
                        Si gestionas tu propiedad en Booking y Airbnb simultáneamente, conectar sus enlaces directamente entre sí puede provocar bloqueos circulares o retrasos en la actualización. Un enlace unificado actúa como **hub centralizador**, consolidando todas las fechas reservadas en un solo punto.
                    </p>
                </div>
                <hr class="border-slate-700/50">
                <div>
                    <h3 class="font-semibold text-indigo-300">¿Cada cuánto tiempo se actualiza la disponibilidad?</h3>
                    <p class="text-slate-400 mt-1">
                        Nuestra herramienta procesa y actualiza los calendarios periódicamente. Cuando una plataforma realiza una petición a tu URL única, se sirve la versión más actualizada almacenada en el servidor.
                    </p>
                </div>
            </div>
        </section>

        <footer class="text-center text-xs text-slate-500 pt-4">
            <p>© {{ "now"|date("Y") }} iCal Merger — Herramienta gratuita para gestores de alquiler vacacional.</p>
        </footer>
    </div>
</div>

<!-- Schema.org FAQ (Rich Snippets para Google) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [{
    "@type": "Question",
    "name": "¿Qué es un archivo iCal / ICS?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Un archivo o enlace iCal es un estándar internacional utilizado por las plataformas de alquiler vacacional para compartir calendarios de ocupación en tiempo real."
    }
  }, {
    "@type": "Question",
    "name": "¿Por qué necesito fusionar mis enlaces iCal?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Fusionar tus enlaces evita bloqueos circulares entre plataformas como Booking y Airbnb, consolidando todas las fechas ocupadas en una sola URL única."
    }
  }]
}
</script>

<script>
    // Lógica para añadir/quitar campos de URL
    const container = document.getElementById('urlsContainer');
    const addBtn = document.getElementById('addUrlBtn');

    if (addBtn) {
        addBtn.addEventListener('click', () => {
            const div = document.createElement('div');
            div.className = 'url-input-group flex gap-2';
            div.innerHTML = `
                <input type="url" name="urls[]" placeholder="https://... (Otra plataforma)"
                       class="flex-1 bg-slate-900 border border-slate-700 rounded-lg px-4 py-2.5 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500">
                <button type="button" onclick="removeInput(this)"
                        class="px-3 py-2 bg-slate-700/50 hover:bg-red-500/20 text-slate-400 hover:text-red-400 rounded-lg border border-slate-600 transition">
                    ✕
                </button>
            `;
            container.appendChild(div);
        });
    }

    function removeInput(btn) {
        const groups = container.querySelectorAll('.url-input-group');
        if (groups.length > 1) {
            btn.closest('.url-input-group').remove();
        }
    }

    // Función principal para copiar al portapapeles
    function copyToClipboard() {
        const input = document.getElementById('generatedUrl');
        const copyBtn = document.getElementById('copyBtn');
        const copyText = document.getElementById('copyText');
        const toast = document.getElementById('toastFeedback');

        if (!input || !input.value) return;

        // Comprobar de forma segura si la API moderna existe Y está activa
        if (typeof navigator !== 'undefined' && navigator.clipboard && typeof navigator.clipboard.writeText === 'function' && window.isSecureContext) {
            navigator.clipboard.writeText(input.value)
                .then(() => showSuccessFeedback(copyBtn, copyText, toast))
                .catch(() => fallbackCopy(input, copyBtn, copyText, toast));
        } else {
            // Si es HTTP o no existe navigator.clipboard, usar fallback tradicional
            fallbackCopy(input, copyBtn, copyText, toast);
        }
    }

    // Método de copia por selección manual (Funciona SIEMPRE, incluso en HTTP)
    function fallbackCopy(input, copyBtn, copyText, toast) {
        try {
            input.focus();
            input.select();
            input.setSelectionRange(0, 99999); // Para compatibilidad en móviles iOS/Android

            const successful = document.execCommand('copy');
            if (successful) {
                showSuccessFeedback(copyBtn, copyText, toast);
            } else {
                alert('Selecciona el texto e introduce Ctrl+C / Cmd+C para copiar.');
            }
        } catch (err) {
            console.error('Error al copiar:', err);
            alert('Selecciona el texto e introduce Ctrl+C / Cmd+C para copiar.');
        }
    }

    // Mostrar feedback visual (Botón en verde + Toast)
    function showSuccessFeedback(copyBtn, copyText, toast) {
        if (copyText) copyText.textContent = '¡Copiado!';
        if (copyBtn) {
            copyBtn.classList.remove('bg-indigo-600', 'hover:bg-indigo-500');
            copyBtn.classList.add('bg-emerald-600', 'hover:bg-emerald-500');
        }

        if (toast) {
            toast.classList.remove('hidden');
        }

        setTimeout(() => {
            if (copyText) copyText.textContent = 'Copiar';
            if (copyBtn) {
                copyBtn.classList.remove('bg-emerald-600', 'hover:bg-emerald-500');
                copyBtn.classList.add('bg-indigo-600', 'hover:bg-indigo-500');
            }
            if (toast) {
                toast.classList.add('hidden');
            }
        }, 2500);
    }
</script>
{% endblock %}
