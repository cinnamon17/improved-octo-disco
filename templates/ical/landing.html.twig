{% extends 'base.html.twig' %}

{% block title %}{{ 'meta.title'|trans }}{% endblock %}

{% block meta_seo %}
    <meta name="description" content="{{ 'meta.description'|trans }}">
    <meta name="keywords" content="fusionar ical, sincronizar booking airbnb, sincronizador calendarios alquiler vacacional, evitar dobles reservas, ical merger gratis, merge ical, sync airbnb booking">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ url(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ 'meta.og_title'|trans }}">
    <meta property="og:description" content="{{ 'meta.og_description'|trans }}">
    <meta property="og:url" content="{{ url(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}">

    <!-- Schema.org (WebApplication) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "iCal Merger & Synchronizer",
      "operatingSystem": "All",
      "applicationCategory": "BusinessApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      },
      "description": "{{ 'meta.description'|trans|e('js') }}"
    }
    </script>
{% endblock %}

{% block body %}
<div class="min-h-screen flex flex-col items-center justify-start p-4 py-12 space-y-12 bg-slate-900 text-slate-100">

    {# Conmutador de Idiomas para SEO / UX #}
    <div class="w-full max-w-4xl flex justify-end gap-3 text-xs font-semibold">
        <a href="{{ url('ical_landing', {'_locale': 'es'}) }}" class="px-3 py-1.5 rounded-md border {% if app.request.locale == 'es' %}bg-indigo-600 text-white border-indigo-500{% else %}bg-slate-800 text-slate-300 border-slate-700 hover:text-white{% endif %} transition">
            Español
        </a>
        <a href="{{ url('ical_landing', {'_locale': 'en'}) }}" class="px-3 py-1.5 rounded-md border {% if app.request.locale == 'en' %}bg-indigo-600 text-white border-indigo-500{% else %}bg-slate-800 text-slate-300 border-slate-700 hover:text-white{% endif %} transition">
            English
        </a>
    </div>

    <!-- BLOQUE 1: Resultado de la URL generada -->
    {% if mergedUrl is defined and mergedUrl is not empty %}
    <div class="max-w-2xl w-full bg-slate-800 border border-emerald-500/40 rounded-xl shadow-2xl p-6 sm:p-8 text-center space-y-5 animate-fade-in">
        <div class="mx-auto w-12 h-12 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center text-2xl border border-emerald-500/40">
            ✓
        </div>

        <div>
            <h2 class="text-2xl font-bold text-white mb-1">{{ 'result.title'|trans }}</h2>
            <p class="text-slate-300 text-sm">
                {{ 'result.subtitle'|trans }}
            </p>
        </div>

        <div class="space-y-2 text-left">
            <label for="generatedUrl" class="block text-xs font-semibold uppercase tracking-wider text-slate-300">{{ 'result.label_url'|trans }}</label>
            <div class="relative flex items-center">
                <input type="text" id="generatedUrl" readonly value="{{ mergedUrl }}"
                       class="w-full bg-slate-900 border border-slate-700 rounded-lg pl-4 pr-28 py-3 text-sm text-indigo-300 font-mono focus:outline-none select-all">

                <button type="button" id="copyBtn" onclick="copyToClipboard()"
                        class="absolute right-1.5 top-1.5 bottom-1.5 px-4 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold rounded-md transition flex items-center gap-1.5 shadow-md">
                    <svg id="copyIcon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 012-2v-8a2 2 0 01-2-2h-8a2 2 0 01-2 2v8a2 2 0 012 2z"></path>
                    </svg>
                    <span id="copyText">{{ 'result.copy_btn'|trans }}</span>
                </button>
            </div>
        </div>

        <div id="toastFeedback" class="hidden bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 text-xs py-2 px-4 rounded-lg flex items-center justify-center gap-2 transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>{{ 'result.toast_success'|trans }}</span>
        </div>
    </div>
    {% endif %}

    <!-- BLOQUE 2: Tarjeta Principal del Formulario -->
    <div class="max-w-2xl w-full bg-slate-800 border border-slate-700 rounded-xl shadow-2xl p-6 sm:p-8">

        <div class="mb-8 text-center">
            <span class="inline-block bg-indigo-500/20 text-indigo-300 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-2 border border-indigo-500/30">
                {{ 'hero.badge'|trans }}
            </span>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-white mb-2">{{ 'hero.title'|trans }}</h1>
            <p class="text-slate-300 text-sm sm:text-base">
                {{ 'hero.subtitle'|trans }}
            </p>
        </div>

        {% for message in app.flashes('error') %}
            <div class="mb-6 bg-red-500/20 border border-red-500/40 text-red-300 px-4 py-3 rounded-lg text-sm">
                {{ message }}
            </div>
        {% endfor %}

        <form action="{{ path('ical_create') }}" method="POST" id="icalForm" class="space-y-4">
            <div id="urlsContainer" class="space-y-3">
                <label class="block text-sm font-semibold text-slate-200">{{ 'form.label_sources'|trans }}</label>

                <div class="url-input-group flex gap-2">
                    <label for="url_1" class="sr-only">{{ 'form.label_sources'|trans }} 1</label>
                    <input type="url" id="url_1" name="urls[]" required placeholder="{{ 'form.placeholder_1'|trans }}"
                           class="flex-1 bg-slate-900 border border-slate-700 rounded-lg px-4 py-2.5 text-sm text-slate-100 placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500">
                    <button type="button" aria-label="Eliminar URL" class="remove-btn hidden px-3 py-2 bg-slate-700/60 hover:bg-red-500/20 text-slate-300 hover:text-red-300 rounded-lg border border-slate-600 transition">
                        ✕
                    </button>
                </div>

                <div class="url-input-group flex gap-2">
                    <label for="url_2" class="sr-only">{{ 'form.label_sources'|trans }} 2</label>
                    <input type="url" id="url_2" name="urls[]" placeholder="{{ 'form.placeholder_2'|trans }}"
                           class="flex-1 bg-slate-900 border border-slate-700 rounded-lg px-4 py-2.5 text-sm text-slate-100 placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500">
                    <button type="button" aria-label="Eliminar URL" class="remove-btn px-3 py-2 bg-slate-700/60 hover:bg-red-500/20 text-slate-300 hover:text-red-300 rounded-lg border border-slate-600 transition" onclick="removeInput(this)">
                        ✕
                    </button>
                </div>
            </div>

            <button type="button" id="addUrlBtn"
                    class="w-full py-2.5 border border-dashed border-slate-600 hover:border-indigo-500/50 text-slate-300 hover:text-indigo-300 rounded-lg text-sm font-medium transition flex items-center justify-center gap-2">
                <span>+</span> {{ 'form.add_platform'|trans }}
            </button>

            <div class="pt-4">
                <button type="submit"
                        class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-3 px-6 rounded-lg shadow-lg shadow-indigo-600/30 transition transform active:scale-[0.98]">
                    {{ 'form.submit'|trans }}
                </button>
            </div>
        </form>
    </div>

    <!-- SECCIÓN SEO: Cómo funciona y Preguntas Frecuentes -->
    <div class="max-w-4xl w-full space-y-12 text-slate-200 px-2">

        <section class="space-y-6">
            <h2 class="text-2xl font-bold text-white text-center">{{ 'steps.title'|trans }}</h2>
            <div class="grid md:grid-cols-3 gap-6">
                <div class="bg-slate-800/80 border border-slate-700 p-5 rounded-xl">
                    <div class="w-8 h-8 bg-indigo-600/30 text-indigo-300 rounded-lg flex items-center justify-center font-bold mb-3">1</div>
                    <h3 class="font-semibold text-white mb-1">{{ 'steps.step1_title'|trans }}</h3>
                    <p class="text-sm text-slate-300">{{ 'steps.step1_desc'|trans }}</p>
                </div>
                <div class="bg-slate-800/80 border border-slate-700 p-5 rounded-xl">
                    <div class="w-8 h-8 bg-indigo-600/30 text-indigo-300 rounded-lg flex items-center justify-center font-bold mb-3">2</div>
                    <h3 class="font-semibold text-white mb-1">{{ 'steps.step2_title'|trans }}</h3>
                    <p class="text-sm text-slate-300">{{ 'steps.step2_desc'|trans }}</p>
                </div>
                <div class="bg-slate-800/80 border border-slate-700 p-5 rounded-xl">
                    <div class="w-8 h-8 bg-indigo-600/30 text-indigo-300 rounded-lg flex items-center justify-center font-bold mb-3">3</div>
                    <h3 class="font-semibold text-white mb-1">{{ 'steps.step3_title'|trans }}</h3>
                    <p class="text-sm text-slate-300">{{ 'steps.step3_desc'|trans }}</p>
                </div>
            </div>
        </section>

        <section class="space-y-6 bg-slate-800/60 border border-slate-700 p-6 sm:p-8 rounded-xl">
            <h2 class="text-2xl font-bold text-white mb-4">{{ 'faq.title'|trans }}</h2>

            <div class="space-y-4 text-sm sm:text-base">
                <div>
                    <h3 class="font-semibold text-indigo-300">{{ 'faq.q1'|trans }}</h3>
                    <p class="text-slate-300 mt-1">{{ 'faq.a1'|trans }}</p>
                </div>
                <hr class="border-slate-700">
                <div>
                    <h3 class="font-semibold text-indigo-300">{{ 'faq.q2'|trans }}</h3>
                    <p class="text-slate-300 mt-1">{{ 'faq.a2'|trans }}</p>
                </div>
                <hr class="border-slate-700">
                <div>
                    <h3 class="font-semibold text-indigo-300">{{ 'faq.q3'|trans }}</h3>
                    <p class="text-slate-300 mt-1">{{ 'faq.a3'|trans }}</p>
                </div>
            </div>
        </section>

        <footer class="text-center text-xs text-slate-400 pt-4">
            <p>© {{ "now"|date("Y") }} {{ 'footer.copyright'|trans }}</p>
        </footer>
    </div>
</div>

<!-- Schema.org FAQ (Adaptado a idioma dinámico) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [{
    "@type": "Question",
    "name": "{{ 'faq.q1'|trans|e('js') }}",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "{{ 'faq.a1'|trans|e('js') }}"
    }
  }, {
    "@type": "Question",
    "name": "{{ 'faq.q2'|trans|e('js') }}",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "{{ 'faq.a2'|trans|e('js') }}"
    }
  }]
}
</script>

<script>
    const container = document.getElementById('urlsContainer');
    const addBtn = document.getElementById('addUrlBtn');
    const placeholderText = "{{ 'form.placeholder_generic'|trans|e('js') }}";

    if (addBtn) {
        addBtn.addEventListener('click', () => {
            const index = container.querySelectorAll('.url-input-group').length + 1;
            const div = document.createElement('div');
            div.className = 'url-input-group flex gap-2';
            div.innerHTML = `
                <label for="url_${index}" class="sr-only">Fuente de iCal ${index}</label>
                <input type="url" id="url_${index}" name="urls[]" placeholder="${placeholderText}"
                       class="flex-1 bg-slate-900 border border-slate-700 rounded-lg px-4 py-2.5 text-sm text-slate-100 placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500">
                <button type="button" aria-label="Eliminar URL" onclick="removeInput(this)"
                        class="px-3 py-2 bg-slate-700/60 hover:bg-red-500/20 text-slate-300 hover:text-red-300 rounded-lg border border-slate-600 transition">
                    ✕
                </button>
            `;
            container.appendChild(div);
        });
    }

    function removeInput(btn) {
        const groups = container.querySelectorAll('.url-input-group');
        if (groups.length > 1) {
            btn.closest('.url-input-group').remove();
        }
    }

    function copyToClipboard() {
        const input = document.getElementById('generatedUrl');
        const copyBtn = document.getElementById('copyBtn');
        const copyText = document.getElementById('copyText');
        const toast = document.getElementById('toastFeedback');

        if (!input || !input.value) return;

        if (typeof navigator !== 'undefined' && navigator.clipboard && typeof navigator.clipboard.writeText === 'function' && window.isSecureContext) {
            navigator.clipboard.writeText(input.value)
                .then(() => showSuccessFeedback(copyBtn, copyText, toast))
                .catch(() => fallbackCopy(input, copyBtn, copyText, toast));
        } else {
            fallbackCopy(input, copyBtn, copyText, toast);
        }
    }

    function fallbackCopy(input, copyBtn, copyText, toast) {
        try {
            input.focus();
            input.select();
            input.setSelectionRange(0, 99999);

            const successful = document.execCommand('copy');
            if (successful) {
                showSuccessFeedback(copyBtn, copyText, toast);
            } else {
                alert('Selecciona el texto e introduce Ctrl+C / Cmd+C para copiar.');
            }
        } catch (err) {
            console.error('Error al copiar:', err);
            alert('Selecciona el texto e introduce Ctrl+C / Cmd+C para copiar.');
        }
    }

    function showSuccessFeedback(copyBtn, copyText, toast) {
        const copiedText = "{{ 'result.copied_btn'|trans|e('js') }}";
        const defaultText = "{{ 'result.copy_btn'|trans|e('js') }}";

        if (copyText) copyText.textContent = copiedText;
        if (copyBtn) {
            copyBtn.classList.remove('bg-indigo-600', 'hover:bg-indigo-500');
            copyBtn.classList.add('bg-emerald-600', 'hover:bg-emerald-500');
        }

        if (toast) {
            toast.classList.remove('hidden');
        }

        setTimeout(() => {
            if (copyText) copyText.textContent = defaultText;
            if (copyBtn) {
                copyBtn.classList.remove('bg-emerald-600', 'hover:bg-emerald-500');
                copyBtn.classList.add('bg-indigo-600', 'hover:bg-indigo-500');
            }
            if (toast) {
                toast.classList.add('hidden');
            }
        }, 2500);
    }
</script>
{% endblock %}
